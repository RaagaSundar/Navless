/**
 * export-script.mts: writes SCRIPT.md, the speaker script, from the same data the slides use (src/data/script.ts + facts.ts +
 * today.ts). Nothing here is typed by hand, so the script and the deck cannot disagree.
 *
 *   npm run script
 */
import { writeFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { NUMBERS, RUN_3, RUN_NOTES } from '../src/data/facts.ts';
import { QA_LIST, SLIDES, totalSeconds, wordsOf } from '../src/data/script.ts';
import { TODAY } from '../src/data/today.ts';

const here = path.dirname(fileURLToPath(import.meta.url));
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const WPM = 150;
const wordsTotal = () => SLIDES.reduce((n, s) => n + wordsOf(s), 0);

const out: string[] = [];
const push = (...l: string[]) => out.push(...l);

push(
  '# Navless pitch script',
  '',
  '*Generated by `npm run script` from `src/data/script.ts`, `facts.ts` and `today.ts`. Edit those, never this file.*',
  '',
  `**Slot:** judging pitch, 3:20 PM, Sequoia (Tresidder 2nd floor). The organisers' message says **13 minutes plus questions** (the judging page says 20 in total). **About ${mmss(wordsTotal() / WPM * 60)} of speech, ${mmss(totalSeconds())} with pauses and clicks: that fits the 13.** Leave the rest for the judges' questions. The order is theirs: problem, one diagram, why this approach, generalizes vs tuned, what breaks it, evidence, hardest problem / next day / who did what.`,
  '',
  '## Before you present: confirm these four things',
  '',
  `1. **Scored runs.** ${TODAY.scored.length ? `Entered: ${TODAY.scored.map((r) => `${r.slot}: ${r.result}`).join(' / ')}.` : '**Nothing entered yet.** After the 11:18 and 2:28 runs, set `TODAY.scored` in `src/data/today.ts` (slot + one true sentence each). It appears on the evidence slide and in the script.'}`,
  `2. **What the scored runs flew.** The script says: live re-planning ${TODAY.replanning ? '**on**' : '**off**'}; localizer ${TODAY.localizerSteering ? '**has steered a real flight**' : '**has never steered a real flight**'}; compass ${TODAY.compassOff ? '**off in PX4** (EKF2_MAG_TYPE 5)' : '**on**'}. These are the defaults from the 2026-11-08 midday handoff. If a flag is wrong, change \`TODAY\` in \`src/data/today.ts\`.`,
  `3. **Why the side ToF sensors are not flown.** ${TODAY.tofReason ? `Entered: ${TODAY.tofReason}` : '**Nothing entered.** You said we no longer use ToF; a judge may ask why. Add one plain sentence as `tofReason` in `src/data/today.ts`; it appears in the script, the Q&A and on /tech.'}`,
  '4. **The simulation numbers** (3 of 3 laps, 0 contacts) are for the route-file build `865db6b`, not for the planner and localizer build. The script says so; do not let it slide into "our flight code passed".',
  '',
  '## Time budget',
  '',
  '| # | Section | Slide builds | Budget | Script words | At 150 wpm |',
  '|---|---|---|---|---|---|',
);
for (const s of SLIDES) {
  const w = wordsOf(s);
  const flag = (w / WPM) * 60 > s.seconds * 1.15 ? ' **over**' : '';
  push(`| ${s.chapter || '·'} | ${s.label} | ${s.steps} | ${mmss(s.seconds)} | ${w} | ${mmss((w / WPM) * 60)}${flag} |`);
}
const words = SLIDES.reduce((n, s) => n + wordsOf(s), 0);
push(`| | **Total** | | **${mmss(totalSeconds())}** | **${words}** | **${mmss((words / WPM) * 60)}** |`, '');

push(
  '## Keys',
  '',
  '`→` / space next build · `←` back · `1`–`7` sections · `0` title · `N` notes and timer (private) · `Q` numbers and likely questions · `L` live demo (esc to leave) · `B` backdrop off for a weak projector · `F` fullscreen · `T` cinematic tour · `?` help. The URL hash keeps your place if the page reloads (`#evidence.2`).',
  '',
  '## The script',
  '',
  'Cues in *italics* are not spoken. Say it the way you would say it to one judge across a table: short sentences, the number, then what it means.',
  '',
);

for (const s of SLIDES) {
  push(`### ${s.chapter ? `${s.chapter} · ` : ''}${s.label} *(${mmss(s.seconds)})*`, '');
  push(`Slide: **${s.claim}**`, '');
  for (const b of s.beats) {
    push(`**${s.steps > 1 ? `Build ${b.step + 1}/${s.steps}` : 'Slide'}**${b.cue ? ` *[${b.cue}]*` : ''}`, '', `> ${b.say}`, '');
    if (b.todo) push(`> **TODO:** ${b.todo}`, '');
  }
}

push('## Evidence, run by run', '', '| Run | It believed | What happened | Source |', '|---|---|---|---|');
const runLabels: Record<string, string> = { '20261108-091401': 'Run 1', '20261108-092321': 'Run 2', '20261108-114602': 'Run 4', '20261108-133310': 'Run 5' };
for (const [id, n] of Object.entries(RUN_NOTES)) push(`| ${runLabels[id]} | ${n.believed} | ${n.happened} | flight log ${id}_course.csv |`);
push('', `${RUN_3}`, '', '*Contact times and positions on the plot are read from the logs: the first tick where the camera pose cannot be physical (a step over 0.25 m in 0.1 s, or a heading change over 10 degrees in one tick), walked back to where PX4 and the camera headings first parted by more than 2 degrees. Method and code: `scripts/extract-evidence.mjs`.*', '');

push('## If they ask', '', '| Question | Short answer |', '|---|---|');
for (const q of QA_LIST) push(`| ${q.q} | ${q.a.replace(/\|/g, '/')} |`);
push('');

push('## Every number, and where it came from', '');
for (const s of SLIDES.filter((x) => x.chapter > 0)) {
  push(`### ${s.chapter} · ${s.label}`, '', '| Number | What it is | Source |', '|---|---|---|');
  for (const n of NUMBERS.filter((x) => x.section === s.chapter)) push(`| **${n.value}** | ${n.what} | ${n.source} |`);
  push('');
}

push(
  '## Things not to claim',
  '',
  '- That side time-of-flight centring is flying, or that the cinematic deck shows it: its tunnel beat shows blind carry.',
  '- That the tunnel has been flown for real. None of the overnight attempts got that far, so every tunnel result is simulation.',
  '- That the localizer, live re-planning or the planner path has flown a clean lap on the real drone. (Check `TODAY` first.)',
  '- That the simulation numbers are for the build that flies. They are for the route-file build `865db6b`.',
  '- That the browser planner is the flight planner. It is a TypeScript re-implementation of the same idea; its telemetry is labelled SIM.',
  '- A single value for the run-2 pose jump. The log says 1.1 m then 1.7 m (2.8 m); the README says 2.9 m, Shining 2.7 m.',
  '',
);

const file = path.join(here, '..', 'SCRIPT.md');
writeFileSync(file, out.join('\n'));
console.log(`wrote ${path.relative(process.cwd(), file)}: ${words} words, about ${mmss((words / WPM) * 60)} at ${WPM} wpm (budget ${mmss(totalSeconds())})`);
