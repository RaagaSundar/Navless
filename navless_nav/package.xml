<?xml version="1.0"?>
<package format="3">
  <name>navless_nav</name>
  <version>0.1.0</version>
  <description>
    Navless DroneHacks competitor node. Takes over when the safety pilot arms,
    then switches to Position, and flies the course through skybeta's
    flight_interface (/skybeta/setpoint/*). Never publishes to /fmu/in/*.
  </description>
  <maintainer email="rsundar31@gatech.edu">Raaga Sundar</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>skybeta_flight_interface</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
